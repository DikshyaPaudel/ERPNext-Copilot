{
 "doctype": "DocType",
 "name": "Copilot Conversation",
 "module": "Erpnext Copilot",
 "custom": 0,
 "autoname": "hash",
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "in_list_view": 1,
   "default": "New chat"
  },
  {
   "fieldname": "history_json",
   "fieldtype": "Long Text",
   "label": "History (JSON)",
   "description": "Full serialized Gemini Content/Part history for this conversation, same shape agent_api.py already caches — including thought_signature on function-call parts."
  },
  {
   "fieldname": "last_message_at",
   "fieldtype": "Datetime",
   "label": "Last message at",
   "in_list_view": 1
  }
 ],
 "permissions": [
  {
   "role": "All",
   "create": 1
  },
  {
   "role": "All",
   "if_owner": 1,
   "read": 1,
   "write": 1,
   "delete": 1
  },
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
 ]
}